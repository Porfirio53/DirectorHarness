# Authoritative workspace for Writer, Actor, HarnessBench grading, and MCP-Persona.
# Future experiment runs require changing only these two values.
OPENAI_API_BASE=
OPENAI_API_KEY=

# Optional Anthropic-compatible settings for the real OpenHarness tests.
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Standalone Writer/UI settings inherit the authoritative workspace above.
WRITER_MODEL=qwen3.6-plus
WRITER_BASE_URL=${OPENAI_API_BASE}
WRITER_API_KEY=${OPENAI_API_KEY}

ACTOR_MODEL=qwen3.6-plus
ACTOR_BASE_URL=${OPENAI_API_BASE}
ACTOR_API_KEY=${OPENAI_API_KEY}
ACTOR_API_FORMAT=openai

OH_BIN=oh
OPENHARNESS_SRC=./OpenHarness/src
