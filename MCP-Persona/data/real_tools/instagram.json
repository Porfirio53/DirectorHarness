  "instagram:get_post_comments": {
    "name": "get_post_comments",
    "original_name": "get_post_comments",
    "server": "instagram",
    "description": "Get comments on an instagram post.",
    "input_schema": {
      "type": "object",
      "properties": {
        "after": {
          "type": [
