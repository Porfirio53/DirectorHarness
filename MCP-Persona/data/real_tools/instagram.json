          "type": [
            "string",
            "null"
          ],
          "description": "Graph Api Version",
          "default": "v21.0"
        },
        "ig_post_id": {
          "type": "string",
          "description": "Instagram Post ID"
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ],
          "description": "Number of comments to return (max 100)",
          "default": 25
        }
      },
      "required": [
        "ig_post_id"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
