{
  "instagram:create_carousel_container": {
    "name": "create_carousel_container",
    "original_name": "create_carousel_container",
    "server": "instagram",
    "description": "Create a draft carousel post with multiple images/videos before publishing.",
    "input_schema": {
      "type": "object",
      "properties": {
        "caption": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Caption"
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of child creation_ids (image/video items)"
        },
        "graph_api_version": {
          "type": [
            "string",
            "null"
          ],
          "description": "Graph Api Version",
          "default": "v21.0"
        },
        "ig_user_id": {
          "type": "string",
          "description": "Instagram Business Account ID"
        }
      },
      "required": [
        "children",
        "ig_user_id"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "instagram:create_media_container": {
    "name": "create_media_container",
    "original_name": "create_media_container",
    "server": "instagram",
    "description": "Create a draft media container for photos/videos/reels before publishing.",
    "input_schema": {
      "type": "object",
      "properties": {
        "caption": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Post caption"
        },
        "content_type": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "photo",
                "video",
                "reel",
                "carousel_item"
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What you want to post: 'photo', 'video', 'reel', or 'carousel_item' (for carousel drafts)"
        },
        "cover_url": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Optional cover image URL for reels/videos"
        },
        "graph_api_version": {
          "type": [
            "string",
            "null"
          ],
          "description": "Graph Api Version",
          "default": "v21.0"
        },
        "ig_user_id": {
          "type": "string",
          "description": "Instagram Business Account ID"
        },
        "image_url": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Public URL of the image"
        },
        "is_carousel_item": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Is Carousel Item"
        },
        "media_type": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Explicit media type override, e.g., REELS or CAROUSEL."
        },
        "video_url": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Public URL of the video"
        }
      },
      "required": [
        "ig_user_id"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "instagram:create_post": {
