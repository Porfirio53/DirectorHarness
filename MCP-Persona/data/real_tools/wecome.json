{
  "wecome:send_text": {
    "name": "send_text",
    "original_name": "send_text",
    "server": "mcp-wecombot-server",
    "description": "Send a text message to WeCom group",
    "input_schema": {
      "type": "object",
      "properties": {
        "content": {
          "description": "Text content to send",
          "type": "string"
        },
        "mentioned_list": {
          "description": "List of user IDs to mention,Multiple people use commas to separate, such as @xiaoyang, @wike.",
          "type": "string"
        },
        "mentioned_mobile_list": {
          "description": "List of mobile numbers to mention,Multiple people use commas to separate, such as @xiaoyang, @wike.",
          "type": "string"
        }
      },
      "required": [
        "content"
      ]
    }
  },
  "wecome:send_markdown": {
    "name": "send_markdown",
