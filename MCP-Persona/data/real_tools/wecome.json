    "input_schema": {
      "type": "object",
      "properties": {
        "content": {
          "description": "Markdown content to send",
          "type": "string"
        }
      },
      "required": [
        "content"
      ]
    }
  },
  "wecome:send_image": {
    "name": "send_image",
    "original_name": "send_image",
    "server": "mcp-wecombot-server",
    "description": "Send an image message to WeCom group",
    "input_schema": {
      "type": "object",
      "properties": {
        "base64_data": {
          "description": "Base64 encoded image data",
