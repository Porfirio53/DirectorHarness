        },
        "card_action_pagepath": {
          "description": "Page path for the card action",
          "type": "string"
        },
        "card_action_type": {
          "description": "Type of the card action",
          "type": "number"
        },
        "card_action_url": {
          "description": "URL for the card action",
          "type": "string"
        },
        "card_type": {
          "description": "Type of the template card",
          "type": "string"
        },
        "main_desc": {
          "description": "Main description of the template card",
          "type": "string"
        },
        "main_title": {
          "description": "Main title of the template card",
          "type": "string"
        }
      },
      "required": [
