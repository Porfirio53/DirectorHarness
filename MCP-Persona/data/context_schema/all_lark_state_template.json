  "email": { "type": "llm", "prompt_hint": "可选邮箱；要么留空，要么输出一个看起来合理的邮箱", "max_tokens": 48 },
  "employee_no": { "type": "enum", "choices": [""] },
  "employee_type": { "type": "enum", "choices": [0, 1] },
  "en_name": { "type": "llm", "prompt_hint": "可选英文名；要么留空，要么只输出英文名（不要解释）", "max_tokens": 24 },
  "gender": { "type": "enum", "choices": [0, 1] },
  "is_tenant_manager": { "type": "enum", "choices": [false] },
