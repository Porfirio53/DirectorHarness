          "attendee_ability": { "type": "enum", "choices": ["can_see_others", "can_invite_others", "can_modify_event"] },
          "color": { "type": "special", "generator": "color" },
          "create_time": { "type": "llm", "prompt_hint": "事件创建时间，输出 Unix 秒级时间戳字符串（如 1772855036），应在过去", "max_tokens": 24 },
          "description": { "type": "llm", "prompt_hint": "可选事件描述；要么留空，要么 1-3 句话英文", "max_tokens": 160 },
          "end_time.timezone": { "type": "enum", "choices": ["UTC", "Asia/Shanghai"] },
          "end_time.timestamp": { "type": "llm", "prompt_hint": "事件结束时间，Unix 秒级时间戳字符串；应大于 start_time.timestamp", "max_tokens": 24 },
          "free_busy_status": { "type": "enum", "choices": ["busy", "free"] },
          "is_exception": { "type": "enum", "choices": [false] },
          "recurrence": { "type": "enum", "choices": [""] },
          "start_time.timezone": { "type": "enum", "choices": ["UTC", "Asia/Shanghai"] },
          "start_time.timestamp": { "type": "llm", "prompt_hint": "事件开始时间，Unix 秒级时间戳字符串；应在未来", "max_tokens": 24 },
          "status": { "type": "enum", "choices": ["confirmed", "tentative", "cancelled"] },
          "summary": { "type": "llm", "prompt_hint": "可选事件标题；要么留空，要么不超过 30 个字符", "max_tokens": 48 },

          "vchat.meeting_url": {
            "type": "special",
            "generator": "vchat_meeting_url",
            "generator_params": { "event_id": "special.event_id" }
          },
          "vchat.vc_type": { "type": "enum", "choices": ["vc"] },
          "visibility": { "type": "enum", "choices": ["public", "private", "default"] },

          "app_link": {
            "type": "special",
            "generator": "event_app_link",
            "generator_params": {
              "calendar_id_numerical": "special.calendar_id_numerical",
              "event_id": "special.event_id",
              "start_ts": "flesh.start_time.timestamp"
            }
          },

          "attendees": {
            "*": {
              "attendee_id": { "type": "special", "example": "user_1308523287452461237" },
              "user_id": { "type": "special", "generator": "reuse", "value": "identifier.user_id" },
              "name": { "type": "special", "generator": "reuse", "value": "identifier.name" },
              "is_organizer": { "type": "enum", "choices": [true] }
            }
          }
        }
      }
    }
  },

