      "color": { "type": "special", "generator": "color" },
      "description": { "type": "llm", "prompt_hint": "可选日历描述；要么留空，要么不超过 20 个英文单词", "max_tokens": 64 },
      "permissions": { "type": "enum", "choices": ["private", "public"] },
